# Spotify API credentials (required for the "Recently Played" widget)
# Get these from https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Generate a refresh token by following the OAuth2 Authorization Code flow
# with scopes: user-read-currently-playing user-read-recently-played
SPOTIFY_REFRESH_TOKEN=your_refresh_token_here

# Shared portfolio heart counter (Upstash Redis / Vercel KV REST)
# Vercel KV usually provides KV_REST_API_URL and KV_REST_API_TOKEN.
# Upstash Redis usually provides UPSTASH_REDIS_REST_URL and UPSTASH_REDIS_REST_TOKEN.
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
